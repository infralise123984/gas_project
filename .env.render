# .env.render - Variables de entorno para Render
# Copia estos valores al dashboard de Render (Environment)
# REEMPLAZA los valores con los tuyos

# Seguridad
SECRET_KEY=tu-secret-key-super-seguro-aqui-genera-uno-fuerte
DEBUG=False

# Hosts (REEMPLAZA con tu dominio de Render)
ALLOWED_HOSTS=tu-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com

# Database - Plan GRATUITO de Render
# Copia aquí la URL de PostgreSQL que te proporcione Render (o tu proveedor externo)
# Formato: postgresql://usuario:password@host:5432/nombre_bd
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Superuser (OPCIONAL - deja en blanco si no quieres crear uno automáticamente)
# Si SUPERUSER_USERNAME está presente, build.sh creará el superuser automáticamente
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=tu-password-super-seguro

# Python
PYTHONUNBUFFERED=1
