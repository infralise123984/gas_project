# ==============================================================================
# GasFácil - Plantilla de variables de entorno
# ==============================================================================
# 1. Copiar este archivo como .env en la raíz del proyecto:
#       copy .env.example .env      (Windows)
#       cp .env.example .env        (Linux / macOS)
# 2. Completar los valores. Las variables marcadas [OBLIGATORIA] deben tener
#    valor o Django no arranca (gasmanager/settings.py lanza ValueError).
# 3. NUNCA subir el .env real al repositorio: ya está en .gitignore.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# DJANGO - CORE
# ──────────────────────────────────────────────────────────────────────────────

# [OBLIGATORIA] Clave secreta de Django.
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo depuración. En local: True. Si se omite, el default del código es False.
DEBUG=True

# [OBLIGATORIA] Hosts permitidos, separados por coma y SIN esquema.
# Local: localhost,127.0.0.1  |  Render: midominio.onrender.com,midominio.cl
ALLOWED_HOSTS=localhost,127.0.0.1

# [OBLIGATORIA] Orígenes confiables para CSRF, separados por coma y CON esquema.
# Local: http://localhost:8000,http://127.0.0.1:8000
# Render: https://midominio.onrender.com
# Si se usa ngrok para probar en el teléfono, agregar también la URL del túnel.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ──────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# Si DATABASE_URL tiene valor, TIENE PRIORIDAD sobre todas las variables DB_*.
# Render inyecta DATABASE_URL automáticamente al crear la base de datos.
# ──────────────────────────────────────────────────────────────────────────────

# DB_ENGINE + DB_*  →  usar estas tres opciones según el motor:
#
#   MySQL:    DB_ENGINE=django.db.backends.mysql      DB_NAME=kimgas
#   SQLite:   DB_ENGINE=django.db.backends.sqlite3    DB_NAME=db.sqlite3
#   Postgres: DB_ENGINE=django.db.backends.postgresql DB_NAME=kimgas
DB_ENGINE=django.db.backends.mysql
DB_NAME=kimgas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Alternativa de una sola línea (formato PaaS). Dejar vacío en local si se usan las DB_* de arriba.
# DATABASE_URL=mysql://usuario:password@127.0.0.1:3306/kimgas

# ──────────────────────────────────────────────────────────────────────────────
# WEB PUSH (VAPID) - Notificaciones a camioneros
# Generar las claves con:  python scripts/generate_vapid.py
# Si se dejan vacías, la app funciona igual pero no se envían notificaciones.
# Para producción deben ser claves distintas y guardarse solo en las variables
# de entorno de Render (nunca en el repositorio).
# ──────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@kimgas.cl

# PUSH DE LA APP NATIVA (FCM) - avisos al telefono del camionero
# Cuenta de servicio de Firebase: consola -> Configuracion del proyecto ->
# Cuentas de servicio -> "Generar nueva clave privada" (descarga un .json).
# SECRETO: quien lo tenga puede mandar avisos a todos los telefonos del proyecto.
# Guardarlo FUERA del repositorio.
#   Local  -> la RUTA al archivo .json
#   Render -> el CONTENIDO del .json en FCM_CREDENCIALES_JSON
FCM_CREDENCIALES_ARCHIVO=


# ──────────────────────────────────────────────────────────────────────────────
# SUPERUSUARIO AUTOMÁTICO (solo despliegue)
# Si las tres están definidas, build.sh ejecuta "python manage.py create_superuser_env"
# para crear el superusuario en Render. Dejar vacías en local y usar:
#   python manage.py createsuperuser
# ──────────────────────────────────────────────────────────────────────────────
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# GUNICORN / RENDER
# ──────────────────────────────────────────────────────────────────────────────

# Muestra los logs sin buffer (recomendado en Render para ver errores en vivo).
PYTHONUNBUFFERED=1
